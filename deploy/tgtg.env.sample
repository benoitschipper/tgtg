# Copy to /mnt/usb/tgtg/tgtg.env and chmod 600. No quotes: podman keeps them literally.
TGTG_USERNAME=
TELEGRAM=true
TELEGRAM_TOKEN=
TELEGRAM_CHAT_IDS=
TZ=Europe/Amsterdam
LOCALE=nl_NL
SCHEDULE_CRON=*/5 7-23 * * *
DISABLE_TESTS=false
# Port of the browser PIN login form (published as 3000 in tgtg.service)
PORT=3000
# Optional, only after a manual login (scanner --tokens):
# TGTG_ACCESS_TOKEN=
# TGTG_REFRESH_TOKEN=
# TGTG_DATADOME=
